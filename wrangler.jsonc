// Cloudflare settings: serve the built site in dist/, plus a small worker for the contact form.
{
  "name": "plain-web-site",
  "compatibility_date": "2026-10-01",
  // Handles /api/* only (the contact form). Every other request is a static file from dist/.
  "main": "worker/index.ts",
  // Serve the site on the domain. Both are added as Cloudflare custom domains on deploy.
  "routes": [
    { "pattern": "plain-web.com", "custom_domain": true },
    { "pattern": "www.plain-web.com", "custom_domain": true }
  ],
  // Keep the workers.dev address, and a preview link for every branch.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Where "Start a site" submissions are emailed. They're sent through Resend, using the
  // RESEND_API_KEY secret set in the Cloudflare dashboard (Production and Previews).
  "vars": { "CONTACT_TO": "robert@plain-web.com" },
  // Branch previews (npx wrangler preview). Vars aren't inherited, so they're repeated here.
  "previews": {
    "vars": { "CONTACT_TO": "robert@plain-web.com" }
  }
}
