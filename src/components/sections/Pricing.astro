---
import SectionHeader from '../SectionHeader.astro';
import TierArt from '../TierArt.astro';
import { pricing } from '../../data/home';
---

<section class="pw-section rule-top" id="pricing" aria-labelledby="pricing-title">
  <div class="pw-container">
    <SectionHeader eyebrow={pricing.eyebrow} title={pricing.title} intro={pricing.intro} id="pricing-title" />
    <ul role="list" class="tiers">
      {pricing.tiers.map((t) => (
        <li class="tier">
          <TierArt tier={t.tier} />
          <p class="spec num">Tier {String(t.tier).padStart(2, '0')}</p>
          <h3 class="heading-3">{t.name}</h3>
          <p class="price"><span class="from">From</span> <span class="amount">{t.price}</span></p>
          <p class="best"><span class="spec">Best for</span>{t.bestFor}</p>
          <ul role="list" class="checks">
            {t.includes.map((item) => (
              <li>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M3.5 9.5l3.5 3.5 7.5-8"></path></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="#start" class="pw-btn pw-btn-primary pw-btn-block cta">{t.cta}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiers { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: stretch; }
  .tier { flex: 1 1 300px; min-width: 0; background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); box-shadow: var(--shadow-hard); padding: var(--space-7); display: flex; flex-direction: column; gap: 1.1rem; }
  .num { color: var(--cobalt); }
  .price { display: flex; align-items: baseline; gap: 0.5rem; }
  .from { font-size: 0.9375rem; color: var(--ink-muted); }
  .amount { font-size: 1.875rem; line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }
  .best { padding: 0.85rem 1rem; background: var(--paper); border-radius: var(--radius-md); line-height: 1.5; }
  .best .spec { display: block; color: var(--ink-muted); }
  .checks { display: flex; flex-direction: column; gap: 0.6rem; }
  .checks li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.4; }
  .checks svg { flex-shrink: 0; margin-top: 2px; fill: none; stroke: var(--cobalt); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cta { margin-top: auto; }
</style>
