---
import SectionHeader from '../SectionHeader.astro';
import { process } from '../../data/home';
const days = Array.from({ length: 14 }, (_, i) => i + 1);
---

<section class="pw-section pw-tex-dots" id="process" aria-labelledby="process-title">
  <div class="pw-container">
    <SectionHeader eyebrow={process.eyebrow} title={process.title} intro={process.intro} id="process-title" />
    <div class="schedule">
      <div class="ruler" aria-hidden="true">
        <span class="spacer"></span>
        <span class="days label">{days.map((d) => <span>{d}</span>)}</span>
      </div>
      <ol role="list">
        {process.phases.map((p) => (
          <li class="phase">
            <div class="text">
              <span class="spec when">{p.days}</span>
              <h3 class="name">{p.name}</h3>
              <p class="body-sm muted">{p.note}</p>
            </div>
            <div class="track" aria-hidden="true">
              <span class:list={['bar', p.tone]} style={`grid-column: ${p.start} / ${p.end + 1}`}></span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .schedule { background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); padding: var(--space-8); display: flex; flex-direction: column; gap: 1.25rem; }
  .ruler { display: flex; flex-wrap: wrap; gap: 0 2rem; }
  .spacer { flex: 1 1 260px; }
  .days { flex: 999 1 520px; display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); text-align: center; font-weight: 400; color: var(--ink-muted); }
  ol { display: flex; flex-direction: column; gap: 1.25rem; margin: 0; }
  .phase { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 2rem; padding-top: 1.25rem; border-top: var(--border-default) dashed var(--line-soft); }
  .text { flex: 1 1 260px; display: flex; flex-direction: column; gap: 0.3rem; }
  .when { color: var(--cobalt); }
  .name { font-size: 1.15rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; }
  .track {
    flex: 999 1 520px; height: 2.25rem; display: grid; grid-template-columns: repeat(14, minmax(0, 1fr));
    background-image: linear-gradient(90deg, var(--tint) 1px, transparent 1px); background-size: calc(100% / 14) 100%;
    border-right: var(--border-hairline) solid var(--tint);
  }
  .bar { margin: 0 2px; border: var(--border-default) solid var(--ink); border-radius: 8px; }
  .peach { background: var(--peach); }
  .mint { background: var(--mint); }
  .cobalt { background: var(--cobalt); }
  .ink { background: var(--ink); }

  @media (max-width: 640px) {
    .schedule { padding: var(--space-5); }
    .spacer { display: none; }
    .days { flex-basis: 100%; }
  }
</style>
