---
// Shown after sending the form when JavaScript is off (the form posts and the worker redirects here).
// Without JavaScript the calendar can't be embedded, so this links to the booking page instead.
import Base from '../../layouts/Base.astro';
import Cube from '../../components/Cube.astro';
import Arrow from '../../components/Arrow.astro';
import { start } from '../../data/start';
import { booking } from '../../data/site';
---

<Base title="Thanks" noindex>
  <section class="pw-section pw-tex-iso">
    <div class="pw-container">
      <div class="sent">
        <Cube palette="launch" size={56} />
        <h1 class="heading-1">{start.success.title}</h1>
        <p class="body-lg muted">{start.success.body}</p>
        <div class="actions">
          <a href={booking.url} class="pw-btn pw-btn-primary">{start.success.pick}<Arrow /></a>
          <a href="/" class="pw-btn pw-btn-secondary">{start.success.back}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sent { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); max-width: 40rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
</style>
