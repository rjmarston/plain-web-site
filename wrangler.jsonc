// Cloudflare settings: serve the built site in dist/ as static files.
{
  "name": "plain-web-site",
  "compatibility_date": "2026-10-01",
  // Add the live domain here once it's registered, e.g.
  // "routes": [{ "pattern": "plainweb.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
