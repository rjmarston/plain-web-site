---
import SectionHeader from '../SectionHeader.astro';
import { process } from '../../data/home';
const days = Array.from({ length: 14 }, (_, i) => i + 1);

// Stage glyphs: 24px, 2px strokes, round caps (same family as the check and arrow).
const icons: Record<string, string> = {
  call: 'M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7l-4 3.5V16H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M8.5 10.5h.01 M12 10.5h.01 M15.5 10.5h.01',
  plan: 'M9 3.5h6v4H9z M3.5 16.5h6v4h-6z M14.5 16.5h6v4h-6z M12 7.5v4.5 M6.5 16.5V12h11v4.5',
  build: 'M3.5 5h17v14h-17z M3.5 9h17 M6.5 7h.01 M9 7h.01 M7 12.5h6 M7 15.5h9',
  review: 'M10.5 3.5a7 7 0 1 1 0 14a7 7 0 0 1 0-14z M15.5 15.5L20.5 20.5 M7.5 10.5l2 2l3.5-3.5',
  launch: 'M6 21V3.5 M6 4h11.5l-2.5 4.25L17.5 12.5H6',
};
const total = process.phases.length;
---

<section class="pw-section pw-tex-dots" id="process" aria-labelledby="process-title">
  <div class="pw-container">
    <SectionHeader eyebrow={process.eyebrow} title={process.title} intro={process.intro} id="process-title" />

    <div class="process" data-process>
      <div class="schedule" data-play>
        <div class="ruler" aria-hidden="true">
          <span class="spacer spec">{process.hint}</span>
          <span class="days label">{days.map((d) => <span>{d}</span>)}</span>
        </div>
        <ol role="list" class="phases">
          {process.phases.map((p, i) => (
            <li class="phase">
              <button
                type="button"
                class:list={['trigger', { 'is-active': i === 0 }]}
                id={`phase-${i}`}
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`phase-detail-${i}`}
              >
                <span class="text">
                  <span class="spec when">{p.days}</span>
                  <span class="name">{p.name}</span>
                  <span class="body-sm muted note">{p.note}</span>
                </span>
                <span class="toggle" aria-hidden="true"></span>
                <span class="track" aria-hidden="true" style={`--end: ${p.end}`}>
                  <span class:list={['bar', p.tone]} style={`grid-column: ${p.start} / ${p.end + 1}; --i: ${i}`}></span>
                </span>
              </button>
              <div class="detail" id={`phase-detail-${i}`} role="region" aria-labelledby={`phase-${i}`}>
                <div class="detail-head">
                  <span class:list={['icon', p.tone]} aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24"><path d={icons[p.icon]}></path></svg>
                  </span>
                  <p class="spec step">Step {i + 1} of {total} · {p.days}</p>
                </div>
                <p class="heading-3 detail-name">{p.name}</p>
                <p class="detail-body">{p.detail}</p>
                <div class="facts">
                  <div>
                    <p class="label fact-label">YOU GET</p>
                    <ul role="list" class="checks">
                      {p.youGet.map((item) => (
                        <li>
                          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M3.5 9.5l3.5 3.5 7.5-8"></path></svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="label fact-label">YOUR TIME</p>
                    <p>{p.yourTime}</p>
                  </div>
                </div>
                <div class="strip" aria-hidden="true">
                  <span class="cells">
                    {days.map((d) => <span class:list={{ on: d >= p.start && d <= p.end, [p.tone]: d >= p.start && d <= p.end }}></span>)}
                  </span>
                  <span class="label strip-label">{p.days.toUpperCase()} OF 14</span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="box" aria-hidden="true"></div>
      <span class="neck" aria-hidden="true"></span>
    </div>

    <p class="timing"><span class="label timing-label">{process.timing.label}</span> <span>{process.timing.text}</span></p>
  </div>
</section>

<script>
  // Desktop: rows select on hover, focus or click, and the detail box beside the chart shows the
  // selected step. Phones: rows open their details inline, one at a time.
  document.querySelectorAll<HTMLElement>('[data-process]').forEach((root) => {
    const triggers = [...root.querySelectorAll<HTMLButtonElement>('.trigger')];
    const neck = root.querySelector<HTMLElement>('.neck')!;
    const wide = window.matchMedia('(min-width: 1024px)');
    let active = Math.max(0, triggers.findIndex((t) => t.getAttribute('aria-expanded') === 'true'));

    const placeNeck = () => {
      if (!wide.matches || active < 0) return;
      const t = triggers[active];
      const y = t.offsetTop + t.offsetHeight / 2 - neck.offsetHeight / 2;
      neck.style.transform = `translateY(${Math.round(y)}px)`;
    };
    const select = (i: number) => {
      active = i;
      triggers.forEach((t, j) => {
        t.setAttribute('aria-expanded', String(j === i));
        t.classList.toggle('is-active', j === i);
      });
      placeNeck();
    };

    triggers.forEach((t, i) => {
      t.addEventListener('pointerenter', (e) => { if (wide.matches && e.pointerType === 'mouse') select(i); });
      t.addEventListener('focus', () => { if (wide.matches) select(i); });
      t.addEventListener('click', () => {
        if (wide.matches) select(i);
        else if (active === i) { active = -1; t.setAttribute('aria-expanded', 'false'); t.classList.remove('is-active'); }
        else select(i);
      });
      t.addEventListener('keydown', (e) => {
        const to = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: triggers.length - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        triggers[(to + triggers.length) % triggers.length].focus();
      });
    });

    wide.addEventListener('change', () => { if (wide.matches && active < 0) select(0); else placeNeck(); });
    new ResizeObserver(placeNeck).observe(root);
    placeNeck();
    requestAnimationFrame(() => root.classList.add('is-ready'));
  });
</script>

<style>
  .process { --pad: var(--space-8); --box-w: clamp(300px, 28vw, 360px); --gap: 28px; }
  .schedule { background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); padding: var(--pad); display: flex; flex-direction: column; gap: 1.25rem; }
  .ruler { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 1.5rem; }
  .spacer { flex: 1 1 240px; color: var(--ink-muted); }
  .days { flex: 999 1 420px; display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); text-align: center; font-weight: 400; color: var(--ink-muted); }
  .phases { display: flex; flex-direction: column; margin: 0 calc(var(--pad) * -1); }

  /* A row is a button: label, then the 14-day track. */
  .trigger {
    position: relative; z-index: 0; width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem;
    padding: 1.1rem var(--pad); background: none; border: 0; border-top: var(--border-default) dashed var(--line-soft);
    text-align: left; cursor: pointer; color: var(--ink);
  }
  /* The selected row's paper band fades in behind it. */
  .trigger::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--paper); opacity: 0; transition: opacity var(--motion-150) var(--ease-out); }
  .trigger:focus-visible { outline-offset: -4px; border-radius: var(--radius-md); }
  .text { flex: 1 1 240px; display: flex; flex-direction: column; gap: 0.3rem; transition: opacity var(--motion-150) var(--ease-out); }
  .when { color: var(--cobalt); }
  .name { font-size: 1.15rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; }
  .track {
    position: relative; flex: 999 1 420px; height: 2.25rem; display: grid; grid-template-columns: repeat(14, minmax(0, 1fr));
    background-image: linear-gradient(90deg, var(--tint) 1px, transparent 1px); background-size: calc(100% / 14) 100%;
    border-right: var(--border-hairline) solid var(--tint);
  }
  .bar {
    margin: 0 2px; border: var(--border-default) solid var(--ink); border-radius: 8px; transform-origin: left center;
    transition: transform var(--motion-150) var(--ease-out), opacity var(--motion-150) var(--ease-out);
  }
  .peach { background: var(--peach); }
  .mint { background: var(--mint); }
  .cobalt { background: var(--cobalt); }
  .ink { background: var(--ink); }

  /* The bars fill in from the left, in order, once the schedule scrolls into view. */
  :global(.js) [data-play]:not(.is-in) .bar { transform: scaleX(0); }
  :global(.js) [data-play].is-in .bar { animation: grow var(--motion-300) var(--ease-out) backwards; animation-delay: calc(var(--i) * 30ms + 150ms); }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* A spec-style footnote under the chart: when two weeks can stretch. */
  .timing {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3);
    max-width: 46rem; margin-top: calc(var(--space-12) * -1 + var(--space-6));
    padding-left: var(--space-4); border-left: var(--border-default) dashed var(--ink-muted);
    font-size: 0.9375rem; line-height: 1.5; color: var(--ink-muted);
  }
  .timing-label { color: var(--ink); }

  .toggle { display: none; }
  .box, .neck { display: none; }

  /* Details, as a block (no JavaScript, and phones) */
  .detail { margin: 0 var(--pad) 1.1rem; padding: var(--space-5); background: var(--paper); border-radius: var(--radius-lg); display: flex; flex-direction: column; gap: var(--space-3); }
  .detail-head { display: flex; align-items: center; gap: var(--space-3); }
  .icon { width: 44px; height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: var(--border-default) solid var(--ink); border-radius: var(--radius-md); }
  .icon svg { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .icon.cobalt svg { stroke: var(--on-cobalt); }
  .icon.ink svg { stroke: var(--paper-raised); }
  .step { color: var(--ink-muted); }
  .detail-body { line-height: 1.55; }
  .facts { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-4); border-top: var(--border-default) dashed var(--line); }
  .fact-label { color: var(--ink-muted); margin-bottom: var(--space-2); }
  .checks { display: flex; flex-direction: column; gap: 0.5rem; }
  .checks li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.4; }
  .checks svg { flex-shrink: 0; margin-top: 2px; fill: none; stroke: var(--cobalt); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* A mini 14-day strip: where this step sits in the two weeks. */
  .strip { display: none; }
  .cells { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: 3px; }
  .cells span { height: 14px; border-radius: 3px; background: var(--white); border: var(--border-hairline) solid var(--line); }
  .cells span.on { border: var(--border-default) solid var(--ink); }
  .cells span.peach { background: var(--peach); }
  .cells span.mint { background: var(--mint); }
  .cells span.cobalt { background: var(--cobalt); }
  .cells span.ink { background: var(--ink); }
  .strip-label { color: var(--ink-muted); }

  /* Phones and tablets, with JavaScript: an accordion. */
  @media (max-width: 1023px) {
    :global(.js) .trigger[aria-expanded='false'] + .detail { display: none; }
    :global(.js) .toggle {
      display: block; position: absolute; top: 1.25rem; right: var(--pad); width: 28px; height: 28px;
      border: var(--border-default) solid var(--ink); border-radius: 50%; background: var(--white);
    }
    :global(.js) .toggle::before, :global(.js) .toggle::after {
      content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px;
      background: var(--ink); transition: transform var(--motion-150) var(--ease-out);
    }
    :global(.js) .toggle::after { transform: rotate(90deg); }
    :global(.js) .trigger[aria-expanded='true'] .toggle::after { transform: rotate(0deg); }
    :global(.js) .text { padding-right: 40px; }
    :global(.js) .detail-name { display: none; }
    .spacer { display: none; }
  }
  @media (max-width: 640px) {
    .process { --pad: var(--space-5); }
    .days { flex-basis: 100%; }
  }

  /* Desktop, with JavaScript: the chart and a detail box side by side, joined by a neck. */
  @media (min-width: 1024px) {
    :global(.js) .process { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--box-w); column-gap: var(--gap); }
    :global(.js) .box {
      display: block; grid-column: 2; grid-row: 1; background: var(--paper); border: var(--border-default) solid var(--ink);
      border-radius: var(--radius-xl); box-shadow: var(--shadow-hard);
    }
    :global(.js) .text { flex-basis: 200px; }
    :global(.js) .track { flex-basis: 260px; }
    :global(.js) .spacer { flex-basis: 200px; }
    :global(.js) .days { flex-basis: 260px; }
    :global(.js) .detail {
      position: absolute; top: 0; bottom: 0; right: 0; width: var(--box-w); margin: 0; padding: var(--space-8) var(--space-7);
      background: none; border-radius: 0; gap: var(--space-4); z-index: 3;
      opacity: 0; visibility: hidden; transition: opacity var(--motion-150) var(--ease-in), visibility 0s linear var(--motion-150);
    }
    :global(.js) .trigger[aria-expanded='true'] + .detail { opacity: 1; visibility: visible; transition: opacity var(--motion-200) var(--ease-out); }
    :global(.js) .detail-head { gap: var(--space-4); }
    :global(.js) .icon { width: 52px; height: 52px; }
    :global(.js) .strip { display: flex; flex-direction: column; gap: var(--space-2); margin-top: auto; padding-top: var(--space-5); }

    /* The selected row: a paper band, a lifted bar and a spec line out to the edge... */
    :global(.js) .trigger.is-active::before { opacity: 1; }
    :global(.js) .trigger.is-active .bar { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink); }
    :global(.js) .trigger.is-active .track::after {
      content: ''; position: absolute; top: 50%; right: calc(var(--pad) * -1);
      left: calc(var(--end) / 14 * 100% + 2px); border-top: var(--border-default) dashed var(--ink);
    }
    /* ...then the neck carries the row across the gap and into the box. */
    :global(.js) .neck {
      display: block; position: absolute; z-index: 2; top: 0; height: 44px;
      left: calc(100% - var(--box-w) - var(--gap) - var(--border-default)); width: calc(var(--gap) + var(--border-default) * 2);
      background: var(--paper); border-top: var(--border-default) solid var(--ink); border-bottom: var(--border-default) solid var(--ink);
      opacity: 0;
    }
    :global(.js) .is-ready .neck { opacity: 1; transition: transform var(--motion-200) var(--ease-out), opacity var(--motion-150) var(--ease-out); }

    /* While you're pointing at the chart, the other rows step back. */
    @media (hover: hover) {
      .schedule:hover .trigger:not(.is-active) .text,
      .schedule:hover .trigger:not(.is-active) .bar { opacity: 0.45; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-play]:not(.is-in) .bar { transform: none; }
    :global(.js) [data-play].is-in .bar { animation: none; }
    .trigger::before, .text, .bar, :global(.js) .toggle::before, :global(.js) .toggle::after { transition: none; }
    :global(.js) .trigger.is-active .bar { transform: none; }
    :global(.js) .is-ready .neck { transition: none; }
    :global(.js) .detail, :global(.js) .trigger[aria-expanded='true'] + .detail { transition: opacity var(--motion-100) linear; }
  }
</style>
