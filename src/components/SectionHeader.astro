---
// Eyebrow (number · name) + heading-1 on the left, intro on the right.
interface Props { eyebrow: string; title: string; intro?: string; id: string; }
const { eyebrow, title, intro, id } = Astro.props;
---

<div class="pw-section-head">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="heading-1" id={id}>{title}</h2>
  </div>
  {intro && <p class="pw-intro">{intro}</p>}
</div>
