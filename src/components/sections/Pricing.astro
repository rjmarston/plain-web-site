---
import SectionHeader from '../SectionHeader.astro';
import TierArt from '../TierArt.astro';
import Arrow from '../Arrow.astro';
import { pricing } from '../../data/home';
import { site } from '../../data/site';
// Each tier's button opens an email that already names the tier.
const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<section class="pw-section rule-top" id="pricing" aria-labelledby="pricing-title">
  <div class="pw-container">
    <SectionHeader eyebrow={pricing.eyebrow} title={pricing.title} intro={pricing.intro} id="pricing-title" />
    <ul role="list" class="tiers">
      {pricing.tiers.map((t) => (
        <li class="tier" data-tier>
          <div class="card">
            <TierArt tier={t.tier} />
            <p class="spec num">Tier {String(t.tier).padStart(2, '0')}</p>
            <h3 class="heading-3">{t.name}</h3>
            <p class="price"><span class="from">From</span> <span class="amount">{t.price}</span></p>
            <p class="best"><span class="spec">Best for</span>{t.bestFor}</p>
            <ul role="list" class="checks">
              {t.includes.map((item) => (
                <li>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M3.5 9.5l3.5 3.5 7.5-8"></path></svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href={mailto(t.cta)} class="pw-btn pw-btn-primary pw-btn-block cta">{t.cta}<Arrow /></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // The whole card is a click target for its button (the button stays the real, focusable link).
  document.querySelectorAll<HTMLElement>('[data-tier]').forEach((tier) => {
    const link = tier.querySelector<HTMLAnchorElement>('.cta');
    tier.addEventListener('click', (event) => {
      if (!link || (event.target as HTMLElement).closest('a')) return;
      if (window.getSelection()?.toString()) return; // let people select text
      link.click();
    });
  });
</script>

<style>
  .tiers { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: stretch; }
  /* The shadow sits on the list item and stays put; the card lifts off it on hover. */
  .tier { position: relative; z-index: 0; flex: 1 1 300px; min-width: 0; display: flex; cursor: pointer; }
  .tier::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: var(--radius-xl); background: var(--ink); transform: translate(6px, 6px); }
  .card {
    flex: 1; min-width: 0; background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl);
    padding: var(--space-7); display: flex; flex-direction: column; gap: 1.1rem;
    transition: transform var(--motion-200) var(--ease-out);
  }
  .tier:hover .card { transform: translate(-3px, -3px); }
  .tier:hover .cta { transform: translate(-2px, -2px); }
  .tier:hover .cta::before { opacity: 1; transform: translate(4px, 4px); }
  .tier:hover .cta .pw-arrow { transform: translateX(3px); }

  .num { color: var(--cobalt); }
  .price { display: flex; align-items: baseline; gap: 0.5rem; }
  .from { font-size: 0.9375rem; color: var(--ink-muted); }
  .amount { font-size: 1.875rem; line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }
  .best { padding: 0.85rem 1rem; background: var(--paper); border-radius: var(--radius-md); line-height: 1.5; }
  .best .spec { display: block; color: var(--ink-muted); }
  .checks { display: flex; flex-direction: column; gap: 0.6rem; }
  .checks li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.4; }
  .checks svg { flex-shrink: 0; margin-top: 2px; fill: none; stroke: var(--cobalt); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cta { margin-top: auto; }

  @media (hover: none) {
    .tier { cursor: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .tier:hover .card, .tier:hover .cta, .tier:hover .cta .pw-arrow { transform: none; }
    .tier:hover .cta::before { transform: translate(2px, 2px); }
  }
</style>
