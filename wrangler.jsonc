// Cloudflare settings: serve the built site in dist/ as static files.
{
  "name": "plain-web-site",
  "compatibility_date": "2026-10-01",
  // Serve the site on the domain. Both are added as Cloudflare custom domains on deploy.
  "routes": [
    { "pattern": "plain-web.com", "custom_domain": true },
    { "pattern": "www.plain-web.com", "custom_domain": true }
  ],
  // Keep the workers.dev address, and a preview link for every branch.
  "workers_dev": true,
  "preview_urls": true,
  // Settings for branch previews (npx wrangler preview). Empty: previews use the same static site.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
