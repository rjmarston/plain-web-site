---
import Timeline from '../Timeline.astro';
import Arrow from '../Arrow.astro';
import { hero } from '../../data/home';
---

<section class="hero pw-tex-iso" aria-labelledby="hero-title">
  <div class="pw-container row">
    <div class="copy">
      <p class="pw-chip">{hero.chip}</p>
      <h1 class="display" id="hero-title">{hero.title} <span class="pw-mark">{hero.highlight}</span></h1>
      <p class="body-lg muted lede">{hero.lede}</p>
      <div class="actions">
        <a href="#start" class="pw-btn pw-btn-primary">{hero.cta}<Arrow /></a>
      </div>
    </div>
    <div class="art">
      <Timeline />
    </div>
  </div>

  <div class="proof">
    <div class="pw-container">
      <ul role="list" class="proof-row">
        {hero.proof.map((p) => (
          <li><span class="value">{p.value}</span> <span class="muted">{p.label}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 3rem; padding-top: 5rem; padding-bottom: 4.5rem; }
  .copy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-6); }
  .lede { max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .art { flex: 1 1 440px; min-width: 0; max-width: 600px; }

  .proof { background: var(--white); border-top: var(--border-default) solid var(--ink); border-bottom: var(--border-default) solid var(--ink); }
  .proof-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 3rem; padding-top: 1.4rem; padding-bottom: 1.4rem; }
  .proof-row li { flex: 0 1 auto; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.75rem; }
  .value { font-size: 1.625rem; line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }

  @media (max-width: 1100px) {
    .proof-row { flex-direction: column; gap: 0.5rem; }
  }

  @media (max-width: 640px) {
    .row { padding-top: 3.5rem; padding-bottom: 3rem; gap: 2.5rem; }
    .copy, .art { flex-basis: 100%; }
  }
</style>
