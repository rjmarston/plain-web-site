---
import SectionHeader from '../SectionHeader.astro';
import ChatDemo from '../ChatDemo.astro';
import { why } from '../../data/home';
const { panel } = why;
---

<section class="pw-section pw-tex-blueprint on-cobalt why" id="why" aria-labelledby="why-title">
  <div class="pw-container">
    <SectionHeader eyebrow={why.eyebrow} title={why.title} intro={why.intro} id="why-title" />

    <ol role="list" class="ledger">
      {why.ledger.map((row) => (
        <li class="row">
          <div class="statement">
            <span class="num">{row.n}</span>
            <h3>{row.statement}</h3>
          </div>
          <p class="cell">
            <span class="label then-label">THEN</span>
            <span class="then">{row.then}</span>
          </p>
          <p class="cell">
            <span class="label now-label">NOW</span>
            <span class="now">{row.now}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="panel">
      <div class="panel-head">
        <div>
          <p class="eyebrow">{panel.eyebrow}</p>
          <h3 class="heading-2">{panel.title}</h3>
        </div>
        <p class="muted panel-intro">{panel.intro}</p>
      </div>
      <div class="compare">
        <div class="col">
          <p class="col-label spec"><span>THE OLD WAY</span><span>{panel.oldWay.length} steps</span></p>
          <div class="steps">
            <ol role="list">
              {panel.oldWay.map((step, i) => (
                <li><span class="n" aria-hidden="true">{i + 1}</span>{step}</li>
              ))}
            </ol>
            <p class="spec foot">{panel.oldWayFoot}</p>
          </div>
        </div>
        <div class="col">
          <p class="col-label spec today"><span>TODAY</span><span>2 messages</span></p>
          <ChatDemo />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why { border-top: var(--border-default) solid var(--ink); border-bottom: var(--border-default) solid var(--ink); }

  /* Then / Now ledger */
  .ledger { margin: 0; border-top: var(--border-default) solid rgba(255, 255, 255, 0.6); }
  .row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem 2.5rem; padding: 1.6rem 0; border-bottom: var(--border-default) dashed rgba(255, 255, 255, 0.45); }
  .statement { flex: 1.4 1 340px; min-width: 0; display: flex; align-items: baseline; gap: 1.25rem; }
  .num { font: 400 0.9rem/1 var(--font-mono); color: var(--mint); }
  .statement h3 { font-size: var(--fs-statement); line-height: 1.2; font-weight: 600; letter-spacing: -0.025em; color: var(--on-cobalt); }
  .cell { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; font-size: 1.02rem; line-height: 1.45; }
  .then-label { color: var(--on-cobalt-label); }
  .now-label { color: var(--mint); }
  .then { color: var(--on-cobalt-soft); text-decoration: line-through; text-decoration-color: var(--peach); text-decoration-thickness: 2px; }
  .now { color: var(--on-cobalt); font-weight: 600; }

  /* The one-conversation panel */
  .panel { background: var(--white); color: var(--ink); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); box-shadow: var(--shadow-hard-lg); padding: var(--space-8); display: flex; flex-direction: column; gap: 1.75rem; }
  .panel .eyebrow { color: var(--cobalt); }
  .panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem 3rem; }
  .panel-head > div { flex: 1 1 380px; display: flex; flex-direction: column; gap: 0.6rem; }
  .panel-intro { flex: 1 1 300px; max-width: 28rem; }
  .compare { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: stretch; }
  .col { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .col-label { display: flex; justify-content: space-between; gap: 1rem; color: var(--ink-muted); }
  .col-label.today { color: var(--cobalt); }
  .steps { flex: 1; background: var(--paper); border: var(--border-default) dashed var(--line); border-radius: var(--radius-lg); padding: var(--space-6); display: flex; flex-direction: column; gap: 1rem; }
  .steps ol { display: flex; flex-direction: column; gap: 0.65rem; margin: 0; }
  .steps li { display: flex; align-items: center; gap: 0.75rem; line-height: 1.4; color: var(--ink-muted); }
  .n { width: 1.6rem; height: 1.6rem; flex-shrink: 0; border: var(--border-default) solid var(--line); border-radius: 50%; background: var(--white); display: flex; align-items: center; justify-content: center; font: 400 0.75rem/1 var(--font-mono); }
  .foot { margin-top: auto; color: var(--ink-muted); }

  @media (max-width: 640px) {
    .cell { flex-basis: 0; flex-grow: 1; }
    .statement { flex-basis: 100%; }
    .panel { padding: var(--space-5); box-shadow: var(--shadow-hard); }
  }
</style>
