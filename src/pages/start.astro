---
// Page pattern: a single form page. Intro on the left, the form on the right (stacked on phones).
import Base from '../layouts/Base.astro';
import Cube from '../components/Cube.astro';
import Arrow from '../components/Arrow.astro';
import { start } from '../data/start';
import { site, booking } from '../data/site';
const s = start.sections;
---

<Base title="Start a site" description="Tell us about your business and the site you need, then pick a time for a 30-minute call.">
  <section class="pw-section pw-tex-iso start" aria-labelledby="start-title">
    <div class="pw-container layout" data-layout>
      <div class="intro">
        <p class="eyebrow">{start.eyebrow}</p>
        <h1 class="heading-1" id="start-title">{start.title}</h1>
        <p class="body-lg muted">{start.intro}</p>
        <ol role="list" class="next">
          {start.next.map((step) => (
            <li><span class="spec num">{step.n}</span><span><strong>{step.title}</strong> {step.body}</span></li>
          ))}
        </ol>
        <p class="alt">{start.emailInstead} <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>

      <div class="card" data-card>
        <form method="post" action="/api/contact" novalidate data-contact>
          <!-- 01 About you -->
          <fieldset class="group">
            <legend class="group-title"><span class="spec">{s.you.n}</span> {s.you.title}</legend>
            <div class="pair">
              <div class="field" data-field="name">
                <label for="f-name">Name</label>
                <input class="input" id="f-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="f-name-err" />
                <p class="error" id="f-name-err" hidden>{start.errors.name}</p>
              </div>
              <div class="field" data-field="email">
                <label for="f-email">Email</label>
                <input class="input" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="name@business.com" required aria-describedby="f-email-err" />
                <p class="error" id="f-email-err" hidden>{start.errors.email}</p>
              </div>
            </div>
            <div class="field" data-field="business">
              <label for="f-business">Business name</label>
              <input class="input" id="f-business" name="business" type="text" autocomplete="organization" maxlength="120" required aria-describedby="f-business-err" />
              <p class="error" id="f-business-err" hidden>{start.errors.business}</p>
            </div>
          </fieldset>

          <!-- 02 Your website today -->
          <fieldset class="group" data-field="hasSite" aria-describedby="f-hasSite-err">
            <legend class="group-title"><span class="spec">{s.site.n}</span> {s.site.title}</legend>
            <p class="question" id="q-site">Do you have one today?</p>
            <div class="pills" role="radiogroup" aria-labelledby="q-site">
              {start.hasSite.map((o) => (
                <label class="pill"><input type="radio" name="has_site" value={o.value} required /><span>{o.label}</span></label>
              ))}
            </div>
            <p class="error" id="f-hasSite-err" hidden>{start.errors.hasSite}</p>
            <div class="field reveal reveal-site" data-field="siteUrl">
              <label for="f-site">Website address</label>
              <input class="input" id="f-site" name="site_url" type="text" inputmode="url" autocomplete="url" maxlength="300" placeholder="yourbusiness.com" aria-describedby="f-siteUrl-err" />
              <p class="error" id="f-siteUrl-err" hidden>{start.errors.siteUrl}</p>
            </div>
          </fieldset>

          <!-- 03 What you need -->
          <fieldset class="group" data-field="need" aria-describedby="f-need-err">
            <legend class="group-title"><span class="spec">{s.need.n}</span> {s.need.title}</legend>
            <div class="choices">
              {start.needs.map((o) => (
                <label class="choice">
                  <input type="radio" name="need" value={o.value} required />
                  <span class="dot" aria-hidden="true"></span>
                  <span class="choice-text">
                    <span class="choice-title">{o.label}</span>
                    <span class="choice-note">{o.note}</span>
                  </span>
                  <span class="spec choice-meta">{o.detail}</span>
                </label>
              ))}
            </div>
            <p class="error" id="f-need-err" hidden>{start.errors.need}</p>
            <div class="reveal reveal-brand" data-field="brandType" aria-describedby="f-brandType-err">
              <p class="question" id="q-brand">A new brand, or tweaks to the one you have?</p>
              <div class="pills" role="radiogroup" aria-labelledby="q-brand">
                {start.brandTypes.map((o) => (
                  <label class="pill"><input type="radio" name="brand_type" value={o.value} /><span>{o.label}</span></label>
                ))}
              </div>
              <p class="error" id="f-brandType-err" hidden>{start.errors.brandType}</p>
            </div>
          </fieldset>

          <!-- 04 Size and timing (optional) -->
          <fieldset class="group">
            <legend class="group-title"><span class="spec">{s.scope.n}</span> {s.scope.title}</legend>
            <p class="hint">{s.scope.note}</p>
            <p class="question" id="q-size">About how many pages? <span class="optional">Optional</span></p>
            <div class="pills" role="radiogroup" aria-labelledby="q-size">
              {start.sizes.map((o) => (
                <label class="pill"><input type="radio" name="size" value={o.value} /><span>{o.label}</span></label>
              ))}
            </div>
            <p class="question" id="q-features">Features and tools you need <span class="optional">Optional · pick any</span></p>
            <div class="pills" role="group" aria-labelledby="q-features">
              {start.features.map((o) => (
                <label class="pill pill-check">
                  <input type="checkbox" name="features" value={o.value} />
                  <svg aria-hidden="true" viewBox="0 0 18 18" width="14" height="14"><path d="M3.5 9.5l3.5 3.5 7.5-8"></path></svg>
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
            <p class="question" id="q-launch">When do you want to launch? <span class="optional">Optional</span></p>
            <div class="pills" role="radiogroup" aria-labelledby="q-launch">
              {start.launch.map((o) => (
                <label class="pill"><input type="radio" name="launch" value={o.value} /><span>{o.label}</span></label>
              ))}
            </div>
          </fieldset>

          <!-- 05 Anything else -->
          <fieldset class="group">
            <legend class="group-title"><span class="spec">{s.notes.n}</span> {s.notes.title}</legend>
            <div class="field">
              <label for="f-notes">Notes <span class="optional">Optional</span></label>
              <textarea class="input" id="f-notes" name="notes" rows="4" maxlength="3000" aria-describedby="f-notes-hint"></textarea>
              <p class="hint" id="f-notes-hint">Pages you know you need, sites you like, or anything we should know.</p>
            </div>
          </fieldset>

          <!-- Spam checks: a field people never see, and when the form was opened. -->
          <div class="trap" aria-hidden="true">
            <label for="f-url">Leave this empty</label>
            <input id="f-url" name="url" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="t" value="" />

          <div class="actions">
            <button type="submit" class="pw-btn pw-btn-primary submit"><span class="submit-label">{start.submit}</span><Arrow /></button>
            <p class="hint">{start.privacy}</p>
          </div>
          <p class="status" role="status" aria-live="polite"></p>
        </form>

        <!-- After sending: book the 30-minute call. The Cal.com calendar only loads at this point. -->
        <div class="done" tabindex="-1" hidden data-done>
          <div class="done-head">
            <Cube palette="launch" size={48} />
            <div class="done-text" aria-live="polite">
              <h2 class="heading-2" data-done-title>{start.success.title}</h2>
              <p class="body-lg muted" data-done-body>{start.success.body}</p>
            </div>
          </div>
          <div class="book" data-book>
            <p class="spec book-loading" data-book-loading>{start.success.loading}</p>
            <div class="book-frame" id="book-frame"></div>
            <div class="book-failed" data-book-failed hidden>
              <p class="body-lg">{start.success.failed}</p>
              <a class="pw-btn pw-btn-primary" href={booking.url} target="_blank" rel="noopener">{start.success.open}<Arrow /></a>
            </div>
          </div>
          <p class="hint book-alt" data-book-alt>{start.success.slow} <a href={booking.url} target="_blank" rel="noopener">{start.success.open}</a></p>
          <p data-book-back hidden><a href="/" class="pw-btn pw-btn-secondary">{start.success.back}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { start } from '../data/start';
  import { site, booking } from '../data/site';

  // Cal.com's embed script queues calls made before it loads (window.Cal.q).
  type CalApi = ((...args: unknown[]) => void) & { q: unknown[][]; ns: Record<string, unknown>; loaded: boolean };
  const loadCal = (onError: () => void): CalApi => {
    const w = window as unknown as { Cal?: CalApi };
    if (!w.Cal) {
      const cal = ((...args: unknown[]) => { cal.q.push(args); }) as CalApi;
      cal.q = []; cal.ns = {}; cal.loaded = true;
      w.Cal = cal;
      const script = document.createElement('script');
      script.src = 'https://app.cal.com/embed/embed.js';
      script.async = true;
      script.onerror = onError;
      document.head.append(script);
    }
    return w.Cal;
  };

  // Show the booking calendar, filled in with what they just told us.
  const openBooking = (done: HTMLElement, prefill: { name: string; email: string; notes: string }) => {
    const book = done.querySelector<HTMLElement>('[data-book]')!;
    const loading = done.querySelector<HTMLElement>('[data-book-loading]')!;
    const failedBox = done.querySelector<HTMLElement>('[data-book-failed]')!;
    const alt = done.querySelector<HTMLElement>('[data-book-alt]')!;
    const back = done.querySelector<HTMLElement>('[data-book-back]')!;
    const title = done.querySelector<HTMLElement>('[data-done-title]')!;
    const body = done.querySelector<HTMLElement>('[data-done-body]')!;

    let ready = false;
    const fail = () => {
      if (ready) return;
      book.classList.add('is-failed');
      loading.hidden = true; failedBox.hidden = false; alt.hidden = true;
    };
    const timer = setTimeout(fail, 15000);
    const cal = loadCal(fail);
    const brand = getComputedStyle(document.documentElement).getPropertyValue('--cobalt').trim();

    cal('init', { origin: 'https://cal.com' });
    cal('inline', {
      elementOrSelector: '#book-frame',
      calLink: booking.link,
      config: { ...prefill, layout: 'month_view', theme: 'light' },
    });
    cal('ui', { theme: 'light', layout: 'month_view', hideEventTypeDetails: false, cssVarsPerTheme: { light: { 'cal-brand': brand } } });
    cal('on', { action: 'linkReady', callback: () => {
      ready = true; clearTimeout(timer);
      book.classList.remove('is-failed'); book.classList.add('is-ready');
      loading.hidden = true; failedBox.hidden = true; alt.hidden = false;
    } });
    cal('on', { action: 'linkFailed', callback: () => { ready = false; fail(); } });
    cal('on', { action: 'bookingSuccessfulV2', callback: () => {
      title.textContent = start.success.bookedTitle;
      body.textContent = start.success.bookedBody;
      alt.hidden = true; back.hidden = false;
    } });
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const card = document.querySelector<HTMLElement>('[data-card]')!;
    const done = card.querySelector<HTMLElement>('[data-done]')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;
    const label = button.querySelector<HTMLElement>('.submit-label')!;
    (form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now());

    // Coming from a tier card? Pre-pick that tier.
    const need = new URLSearchParams(location.search).get('need');
    const pre = need && form.querySelector<HTMLInputElement>(`input[name="need"][value="${CSS.escape(need)}"]`);
    if (pre) pre.checked = true;

    const value = (name: string) => {
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) return el.value;
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement ? el.value.trim() : '';
    };
    const normalizeUrl = (raw: string) => {
      try {
        const u = new URL(/^https?:\/\//i.test(raw) ? raw : `https://${raw}`);
        return u.hostname.includes('.') ? u.href : '';
      } catch { return ''; }
    };
    // Each rule returns true when the answer is fine. Hidden follow-ups only count when shown.
    const rules: Record<string, () => boolean> = {
      name: () => value('name').length > 0,
      email: () => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value('email')),
      business: () => value('business').length > 0,
      hasSite: () => value('has_site') !== '',
      siteUrl: () => value('has_site') !== 'yes' || normalizeUrl(value('site_url')) !== '',
      need: () => value('need') !== '',
      brandType: () => value('need') !== 'brand' || value('brand_type') !== '',
    };

    const fieldEl = (key: string) => form.querySelector<HTMLElement>(`[data-field="${key}"]`)!;
    const control = (key: string) => fieldEl(key).querySelector<HTMLInputElement | HTMLTextAreaElement>('input.input, textarea.input');
    const setError = (key: string, on: boolean) => {
      const box = fieldEl(key);
      const err = form.querySelector<HTMLElement>(`#f-${key}-err`);
      box.classList.toggle('is-invalid', on);
      if (err) err.hidden = !on;
      const c = control(key);
      if (c) c.setAttribute('aria-invalid', String(on));
      else box.querySelectorAll('input').forEach((i) => i.setAttribute('aria-invalid', String(on)));
    };
    const check = (key: string) => { const ok = rules[key](); setError(key, !ok); return ok; };

    // If you leave a field by clicking something else, wait until that click lands before
    // showing an error, so the message can't shift the page under the pointer.
    let pointerDown = false;
    let jumping = false; // true while we move focus to the first problem after a submit
    const pending = new Set<string>();
    const flush = () => { pending.forEach((key) => check(key)); pending.clear(); };
    document.addEventListener('pointerdown', () => { pointerDown = true; }, true);
    const release = () => setTimeout(() => { pointerDown = false; flush(); }, 0);
    document.addEventListener('pointerup', release, true);
    document.addEventListener('pointercancel', release, true);

    // Text fields: check when you leave them; once flagged, clear as soon as you start fixing it.
    for (const key of ['name', 'email', 'business', 'siteUrl']) {
      const c = control(key)!;
      c.addEventListener('blur', () => { if (pointerDown) pending.add(key); else check(key); });
      c.addEventListener('focus', () => { if (!jumping && fieldEl(key).classList.contains('is-invalid')) setError(key, false); });
      c.addEventListener('input', () => { if (fieldEl(key).classList.contains('is-invalid')) setError(key, false); });
    }
    // Choices: clear the error as soon as something is picked.
    form.addEventListener('change', (e) => {
      const name = (e.target as HTMLInputElement).name;
      const key = { has_site: 'hasSite', need: 'need', brand_type: 'brandType' }[name];
      if (key && fieldEl(key).classList.contains('is-invalid')) check(key);
      if (name === 'has_site' && value('has_site') === 'no') setError('siteUrl', false);
      if (name === 'need' && value('need') !== 'brand') setError('brandType', false);
    });

    let sending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      const failed = Object.keys(rules).filter((key) => !check(key));
      if (failed.length) {
        status.textContent = start.errors.summary;
        const first = fieldEl(failed[0]);
        jumping = true;
        (first.querySelector<HTMLElement>('input.input, textarea.input') ?? first.querySelector<HTMLElement>('input'))?.focus();
        jumping = false;
        return;
      }

      sending = true;
      button.setAttribute('aria-busy', 'true');
      label.textContent = start.sending;
      status.textContent = '';
      const data = new FormData(form);
      const url = normalizeUrl(value('site_url'));
      if (value('has_site') === 'yes' && url) data.set('site_url', url);

      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (res.status === 422) {
          const body = await res.json().catch(() => ({}));
          const keys = Object.keys(body.errors ?? {});
          keys.forEach((k) => { if (k in rules) setError(k, true); });
          status.textContent = start.errors.summary;
          if (keys[0]) fieldEl(keys[0])?.querySelector<HTMLElement>('input')?.focus();
        } else if (!res.ok) {
          throw new Error(String(res.status));
        } else {
          const n = start.bookingNotes;
          const needLabel = start.needs.find((o) => o.value === value('need'))?.label ?? '';
          const notes = [
            `${n.business}: ${value('business')}`,
            needLabel && `${n.need}: ${needLabel}`,
            value('has_site') === 'yes' && url && `${n.site}: ${url}`,
          ].filter(Boolean).join('\n');
          form.hidden = true;
          done.hidden = false;
          card.classList.add('is-done');
          document.querySelector('[data-layout]')?.classList.add('is-done');
          done.focus({ preventScroll: true });
          card.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          openBooking(done, { name: value('name'), email: value('email'), notes });
        }
      } catch {
        status.innerHTML = '';
        status.append(`${start.errors.failed} `);
        const a = document.createElement('a');
        a.href = `mailto:${site.email}`;
        a.textContent = site.email;
        status.append(a, '.');
      } finally {
        sending = false;
        button.removeAttribute('aria-busy');
        label.textContent = start.submit;
      }
    });
  }
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 4rem; align-items: start; }

  /* Intro: stays in view on desktop while you fill in the form. */
  .intro { position: sticky; top: 112px; display: flex; flex-direction: column; gap: var(--space-5); }
  .next { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-3); padding-top: var(--space-5); border-top: var(--border-default) dashed var(--line); }
  .next li { display: flex; gap: var(--space-4); align-items: baseline; color: var(--ink-muted); line-height: 1.5; }
  .next strong { color: var(--ink); font-weight: 600; }
  .num { color: var(--cobalt); }
  .alt { color: var(--ink-muted); }
  .alt a { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }

  /* The form card */
  .card { background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); box-shadow: var(--shadow-hard-lg); padding: var(--space-8); }
  form { display: flex; flex-direction: column; gap: var(--space-8); }
  form[hidden] { display: none; }
  .group { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .group + .group { padding-top: var(--space-8); border-top: var(--border-default) dashed var(--line-soft); }
  .group-title { padding: 0; margin-bottom: var(--space-1); font-size: 1.1875rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; }
  .group-title .spec { color: var(--cobalt); margin-right: var(--space-2); }

  .pair { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .pair .field { flex: 1 1 220px; }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  label, .question { font-size: 0.9375rem; line-height: 1.4; font-weight: 600; }
  .question { margin-top: var(--space-2); }
  legend + .question, legend + .hint { margin-top: 0; }
  .optional { font-weight: 400; color: var(--ink-muted); margin-left: var(--space-1); }
  .hint { font-size: 0.875rem; line-height: 1.45; color: var(--ink-muted); }
  .error { display: flex; gap: 6px; align-items: baseline; font-size: 0.875rem; line-height: 1.45; color: var(--remove-ink); }
  .error::before { content: '!'; flex-shrink: 0; width: 16px; height: 16px; border-radius: 50%; background: var(--remove-ink); color: var(--white); font: 700 11px/16px var(--font-sans); text-align: center; transform: translateY(2px); }
  .error[hidden] { display: none; }

  .input {
    width: 100%; min-height: 48px; padding: 0 14px; border: var(--border-default) solid var(--ink); border-radius: var(--radius-md);
    background: var(--white); font-size: 1rem; line-height: 1.4;
  }
  textarea.input { min-height: 120px; padding: 12px 14px; resize: vertical; }
  .input::placeholder { color: var(--ink-placeholder); }
  .input:hover { background: var(--paper-raised); }
  .input:focus { outline: 2px solid var(--cobalt); outline-offset: 2px; background: var(--white); }
  .is-invalid .input, .input[aria-invalid='true'] { border-color: var(--remove-ink); background: var(--remove-bg); }

  /* Pills: yes/no, size, features and timing */
  .pills { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pill { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 1rem; border: var(--border-default) solid var(--ink); border-radius: var(--radius-pill); background: var(--white); font-weight: 500; cursor: pointer; user-select: none; }
  .pill input, .choice input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .pill:hover { background: var(--paper); }
  .pill:has(input:checked) { background: var(--ink); color: var(--paper-raised); }
  .pill:has(input:focus-visible), .choice:has(input:focus-visible) { outline: 2px solid var(--cobalt); outline-offset: 3px; }
  .pill-check svg { display: none; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .pill-check:has(input:checked) svg { display: block; }
  .is-invalid > .pills .pill, .is-invalid .pill { border-color: var(--remove-ink); }

  /* Need: one card per tier */
  .choices { display: flex; flex-direction: column; gap: var(--space-3); }
  .choice {
    position: relative; display: flex; align-items: center; gap: var(--space-4); padding: 14px 16px;
    border: var(--border-default) solid var(--ink); border-radius: var(--radius-lg); background: var(--white); cursor: pointer;
    transition: transform var(--motion-150) var(--ease-out);
  }
  .choice:hover { background: var(--paper-raised); }
  .dot { width: 20px; height: 20px; flex-shrink: 0; border: var(--border-default) solid var(--ink); border-radius: 50%; background: var(--white); display: flex; align-items: center; justify-content: center; }
  .dot::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--cobalt); opacity: 0; transform: scale(0.4); transition: opacity var(--motion-150) var(--ease-out), transform var(--motion-150) var(--ease-out); }
  .choice-text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .choice-title { font-weight: 600; line-height: 1.35; }
  .choice-note { font-size: 0.9375rem; line-height: 1.4; color: var(--ink-muted); }
  .choice-meta { color: var(--ink-muted); text-align: right; }
  .choice:has(input:checked) { background: var(--paper); box-shadow: 3px 3px 0 var(--ink); transform: translate(-1px, -1px); }
  .choice:has(input:checked) .dot::after { opacity: 1; transform: none; }
  .choice:has(input:checked) .choice-meta { color: var(--cobalt); }
