---
// Page pattern: a booking page. A short intro, then the Cal.com calendar for a 30-minute call.
// Without JavaScript (or if Cal.com can't load) it links to the booking page instead.
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { start } from '../data/start';
import { site, booking } from '../data/site';
const c = start.calendar;
---

<Base title="Start a site" description="Book a 30-minute call about your business and the site you need. We’ll follow up with a plan, a price and a launch date.">
  <section class="pw-section pw-tex-iso start" aria-labelledby="start-title">
    <div class="pw-container">
      <div class="head">
        <div class="intro">
          <p class="eyebrow">{start.eyebrow}</p>
          <h1 class="heading-1" id="start-title">{start.title}</h1>
          <p class="body-lg muted">{start.intro}</p>
        </div>
        <div class="aside">
          <ol role="list" class="next">
            {start.next.map((step) => (
              <li><span class="spec num">{step.n}</span><span><strong>{step.title}</strong> {step.body}</span></li>
            ))}
          </ol>
          <p class="alt">{start.emailInstead} <a href={`mailto:${site.directEmail}`}>{site.directEmail}</a></p>
        </div>
      </div>

      <div class="card" role="region" aria-label={c.label}>
        <p class="booked" role="status" aria-live="polite" data-booked></p>
        <div class="book" data-book>
          <p class="spec book-loading" data-book-loading>{c.loading}</p>
          <div class="book-frame" id="book-frame"></div>
          <div class="book-failed" data-book-failed hidden>
            <p class="body-lg">{c.failed}</p>
            <a class="pw-btn pw-btn-primary" href={booking.url} target="_blank" rel="noopener">{c.open}<Arrow /></a>
          </div>
          <noscript>
            <div class="book-failed">
              <a class="pw-btn pw-btn-primary" href={booking.url}>{c.open}<Arrow /></a>
            </div>
          </noscript>
        </div>
        <p class="hint book-alt" data-book-alt>{c.slow} <a href={booking.url} target="_blank" rel="noopener">{c.open}</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { start } from '../data/start';
  import { booking } from '../data/site';

  // Cal.com's embed script queues calls made before it loads (window.Cal.q).
  type CalApi = ((...args: unknown[]) => void) & { q: unknown[][]; ns: Record<string, unknown>; loaded: boolean };
  const loadCal = (onError: () => void): CalApi => {
    const w = window as unknown as { Cal?: CalApi };
    if (!w.Cal) {
      const cal = ((...args: unknown[]) => { cal.q.push(args); }) as CalApi;
      cal.q = []; cal.ns = {}; cal.loaded = true;
      w.Cal = cal;
      const script = document.createElement('script');
      script.src = 'https://app.cal.com/embed/embed.js';
      script.async = true;
      script.onerror = onError;
      document.head.append(script);
    }
    return w.Cal;
  };

  const book = document.querySelector<HTMLElement>('[data-book]');
  if (book) {
    const loading = book.querySelector<HTMLElement>('[data-book-loading]')!;
    const failedBox = book.querySelector<HTMLElement>('[data-book-failed]')!;
    const alt = document.querySelector<HTMLElement>('[data-book-alt]')!;
    const booked = document.querySelector<HTMLElement>('[data-booked]')!;

    let ready = false;
    const fail = () => {
      if (ready) return;
      book.classList.add('is-failed');
      loading.hidden = true; failedBox.hidden = false; alt.hidden = true;
    };
    const timer = setTimeout(fail, 15000);

    // Came from a tier card? Note the package in the booking.
    const tier = start.needs.find((o) => o.value === new URLSearchParams(location.search).get('need'));
    const config: Record<string, string> = { layout: 'month_view', theme: 'light' };
    if (tier) {
      config.notes = `${start.packageNote}: ${tier.label} (${tier.detail})`;
      config['metadata[package]'] = tier.value;
    }

    const cal = loadCal(fail);
    const brand = getComputedStyle(document.documentElement).getPropertyValue('--cobalt').trim();
    cal('init', { origin: 'https://cal.com' });
    cal('inline', { elementOrSelector: '#book-frame', calLink: booking.link, config });
    cal('ui', { theme: 'light', layout: 'month_view', hideEventTypeDetails: false, cssVarsPerTheme: { light: { 'cal-brand': brand } } });
    cal('on', { action: 'linkReady', callback: () => {
      ready = true; clearTimeout(timer);
      book.classList.remove('is-failed'); book.classList.add('is-ready');
      loading.hidden = true; failedBox.hidden = true; alt.hidden = false;
    } });
    cal('on', { action: 'linkFailed', callback: () => { ready = false; fail(); } });
    cal('on', { action: 'bookingSuccessfulV2', callback: () => {
      booked.textContent = start.calendar.booked;
      alt.hidden = true;
    } });
  }
</script>

<style>
  /* Intro and steps side by side on desktop, stacked on phones. */
  .head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-6) 4rem; align-items: end; margin-bottom: var(--space-12); }
  .intro { display: flex; flex-direction: column; gap: var(--space-5); max-width: 36rem; }
  .aside { display: flex; flex-direction: column; gap: var(--space-5); }
  .next { display: flex; flex-direction: column; gap: var(--space-4); }
  .next li { display: flex; gap: var(--space-4); align-items: baseline; color: var(--ink-muted); line-height: 1.5; }
  .next strong { color: var(--ink); font-weight: 600; }
  .num { color: var(--cobalt); }
  .alt { color: var(--ink-muted); padding-top: var(--space-4); border-top: var(--border-default) dashed var(--line); }
  .alt a { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }

  /* The calendar card */
  .card { display: flex; flex-direction: column; gap: var(--space-5); background: var(--white); border: var(--border-default) solid var(--ink); border-radius: var(--radius-xl); box-shadow: var(--shadow-hard-lg); padding: var(--space-6); }
  .booked { font-weight: 600; }
  .booked:empty { display: none; }
  .book { position: relative; min-height: 560px; }
  .book.is-ready, .book.is-failed { min-height: 0; }
  .book [hidden] { display: none; }
  .book-loading { color: var(--ink-muted); }
  .book-frame { width: 100%; }
  .book.is-failed .book-frame { display: none; }
  .book-failed { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  .book-alt[hidden] { display: none; }
  .book-alt a { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }
  /* Without JavaScript there's no calendar, just the button to the booking page. */
  :global(html:not(.js)) .book { min-height: 0; }
  :global(html:not(.js)) .book-loading, :global(html:not(.js)) .book-alt { display: none; }

  @media (max-width: 900px) {
    .head { grid-template-columns: minmax(0, 1fr); align-items: start; margin-bottom: var(--space-8); }
  }
  @media (max-width: 640px) {
    .card { padding: var(--space-4); box-shadow: var(--shadow-hard); }
  }
</style>
